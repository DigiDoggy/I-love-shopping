# Copy to .env in the project root and fill in your own values:  cp .env.example .env
# .env is git-ignored. Never commit real keys.

# --- PostgreSQL (local) ---
DB_USER=admin
DB_PASSWORD=1234   # local Docker database only

# --- JWT (Base64, at least 32 bytes): openssl rand -base64 64 ---
JWT_TOKEN_SECRET=

# --- Google reCAPTCHA v3 (https://www.google.com/recaptcha/admin) ---
RECAPTCHA_SECRET_KEY=
FRONTEND_RECAPTCHA_SITE_KEY=

# --- OAuth2 login ---
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers -> OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Mail for password reset (Gmail app password) ---
GOOGLE_EMAIL=
GOOGLE_APP_PASSWORD=
